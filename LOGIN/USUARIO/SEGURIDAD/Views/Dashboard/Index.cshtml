@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var nombreUsuario = ViewData["NombreUsuario"]?.ToString() ?? User.Identity?.Name ?? "Usuario";
}

<div class="welcome-card">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="text-primary mb-3"><i class="fas fa-star"></i> ¡Bienvenido <span id="nombreUsuario">@nombreUsuario</span> al Dashboard de Disko ERP!</h2>
            <p class="lead">Desde aquí podrás administrar todos los aspectos de tu negocio.</p>
            <div class="alert alert-success"><i class="fas fa-check-circle"></i> Sistema operativo - Sesión activa | Rol: <span id="rolUsuario">Usuario</span></div>
        </div>
        <div id="adminButton" style="display: none;">
            <a href="/Admin/Dashboard" class="btn btn-lg" style="background: linear-gradient(135deg, #8b5cf6, #6d28d9); color: white; box-shadow: 0 4px 15px rgba(139, 92, 246, 0.4);">
                <i class="fas fa-shield-alt"></i> Panel de Administrador
            </a>
        </div>
    </div>
</div>

<script>
    // Actualizar nombre y rol desde localStorage si existe
    document.addEventListener('DOMContentLoaded', function() {
        try {
            const sesionLocal = localStorage.getItem('sesionActiva');
            if (sesionLocal) {
                const datos = JSON.parse(sesionLocal);
                if (datos.usuario) {
                    document.getElementById('nombreUsuario').textContent = datos.usuario;
                    console.log('✅ Nombre actualizado desde localStorage:', datos.usuario);
                }
                
                // Mostrar rol y botón de admin si es administrador
                const rol = datos.rol || 'Usuario';
                document.getElementById('rolUsuario').textContent = rol;
                
                if (rol === 'Admin' || rol === 'Administrador') {
                    document.getElementById('adminButton').style.display = 'block';
                    console.log('✅ Usuario es administrador, mostrando panel admin');
                }
            }
        } catch (e) {
            console.log('ℹ️ No hay sesión en localStorage');
        }
    });
</script>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="feature-card text-center">
            <div class="feature-icon"><i class="fas fa-users"></i></div>
            <h4>Clientes</h4>
            <p>Gestión de clientes y fidelización.</p>
            <a href="/Cliente/Index" class="btn btn-outline-primary">
                <i class="fas fa-arrow-right"></i> Ver módulo
            </a>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="feature-card text-center">
            <div class="feature-icon"><i class="fas fa-truck"></i></div>
            <h4>Proveedores</h4>
            <p>Control y contacto con tus proveedores.</p>
            <a href="/Proveedor/Index" class="btn btn-outline-primary">
                <i class="fas fa-arrow-right"></i> Ver módulo
            </a>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="feature-card text-center">
            <div class="feature-icon"><i class="fas fa-boxes"></i></div>
            <h4>Inventario</h4>
            <p>Supervisa existencias y reposiciones.</p>
            <a href="/Producto/Index" class="btn btn-outline-primary">
                <i class="fas fa-arrow-right"></i> Ver módulo
            </a>
        </div>
    </div>
</div>
