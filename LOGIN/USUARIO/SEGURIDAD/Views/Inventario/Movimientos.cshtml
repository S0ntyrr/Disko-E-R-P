@{
    ViewData["Title"] = "Movimientos de Inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2><i class="fas fa-exchange-alt"></i> Movimientos de Inventario</h2>
            <p style="color: rgba(255, 255, 255, 0.9);">Historial de entradas y salidas de productos</p>
        </div>
        <div class="col-md-6 text-end">
            <a href="/Inventario/Movimientos/Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Registrar Movimiento
            </a>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label"><i class="fas fa-filter"></i> Tipo</label>
                    <select class="form-select" id="filtroTipo">
                        <option value="">Todos</option>
                        <option value="Entrada">Entradas</option>
                        <option value="Salida">Salidas</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="fas fa-box"></i> Producto</label>
                    <select class="form-select" id="filtroProducto">
                        <option value="">Todos los productos</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="fas fa-calendar"></i> Desde</label>
                    <input type="date" class="form-control" id="filtroDesde">
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="fas fa-calendar"></i> Hasta</label>
                    <input type="date" class="form-control" id="filtroHasta">
                </div>
            </div>
            <div class="row mt-3">
                <div class="col text-end">
                    <button class="btn btn-secondary" onclick="limpiarFiltrosMovimientos()">
                        <i class="fas fa-times"></i> Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Estadísticas rápidas -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white;">
                <div class="card-body">
                    <h5><i class="fas fa-arrow-down"></i> Total Entradas</h5>
                    <h2 id="totalEntradas">0</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white;">
                <div class="card-body">
                    <h5><i class="fas fa-arrow-up"></i> Total Salidas</h5>
                    <h2 id="totalSalidas">0</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center" style="background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); color: white;">
                <div class="card-body">
                    <h5><i class="fas fa-list"></i> Total Movimientos</h5>
                    <h2 id="totalMovimientos">0</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white;">
                <div class="card-body">
                    <h5><i class="fas fa-balance-scale"></i> Balance</h5>
                    <h2 id="balanceMovimientos">0</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Movimientos -->
    <div class="card">
        <div class="card-body">
            <div id="movimientosContainer">
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let todosLosMovimientos = [];
let productos = [];

document.addEventListener('DOMContentLoaded', function() {
    cargarProductos();
    cargarMovimientos();
    
    // Event listeners
    document.getElementById('filtroTipo').addEventListener('change', aplicarFiltrosMovimientos);
    document.getElementById('filtroProducto').addEventListener('change', aplicarFiltrosMovimientos);
    document.getElementById('filtroDesde').addEventListener('change', aplicarFiltrosMovimientos);
    document.getElementById('filtroHasta').addEventListener('change', aplicarFiltrosMovimientos);
});

function cargarProductos() {
    productos = JSON.parse(localStorage.getItem('productos') || '[]');
    const select = document.getElementById('filtroProducto');
    
    productos.forEach(prod => {
        const option = document.createElement('option');
        option.value = prod.productoId;
        option.textContent = prod.nombre;
        select.appendChild(option);
    });
}

function cargarMovimientos() {
    todosLosMovimientos = JSON.parse(localStorage.getItem('movimientosInventario') || '[]');
    
    // Ordenar por fecha más reciente
    todosLosMovimientos.sort((a, b) => new Date(b.fecha) - new Date(a.fecha));
    
    aplicarFiltrosMovimientos();
}

function aplicarFiltrosMovimientos() {
    const tipo = document.getElementById('filtroTipo').value;
    const productoId = document.getElementById('filtroProducto').value;
    const desde = document.getElementById('filtroDesde').value;
    const hasta = document.getElementById('filtroHasta').value;
    
    let movimientosFiltrados = [...todosLosMovimientos];
    
    // Filtro por tipo
    if (tipo) {
        movimientosFiltrados = movimientosFiltrados.filter(m => m.tipo === tipo);
    }
    
    // Filtro por producto
    if (productoId) {
        movimientosFiltrados = movimientosFiltrados.filter(m => 
            m.productoId === parseInt(productoId)
        );
    }
    
    // Filtro por fecha
    if (desde) {
        movimientosFiltrados = movimientosFiltrados.filter(m => 
            new Date(m.fecha) >= new Date(desde)
        );
    }
    
    if (hasta) {
        const fechaHasta = new Date(hasta);
        fechaHasta.setHours(23, 59, 59, 999);
        movimientosFiltrados = movimientosFiltrados.filter(m => 
            new Date(m.fecha) <= fechaHasta
        );
    }
    
    mostrarMovimientos(movimientosFiltrados);
    calcularEstadisticas(movimientosFiltrados);
}

function mostrarMovimientos(movimientos) {
    if (movimientos.length === 0) {
        document.getElementById('movimientosContainer').innerHTML = `
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> No hay movimientos registrados.
            </div>
        `;
        return;
    }
    
    let html = `
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha/Hora</th>
                        <th>Producto</th>
                        <th>Tipo</th>
                        <th>Cantidad</th>
                        <th>Stock Anterior</th>
                        <th>Stock Nuevo</th>
                        <th>Motivo</th>
                        <th>Usuario</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
    `;
    
    movimientos.forEach(mov => {
        const tipoBadge = mov.tipo === 'Entrada' ? 'bg-success' : 'bg-danger';
        const tipoIcon = mov.tipo === 'Entrada' ? 'fa-arrow-down' : 'fa-arrow-up';
        const fecha = new Date(mov.fecha);
        
        html += `
            <tr>
                <td>
                    ${fecha.toLocaleDateString('es-CO')}<br>
                    <small class="text-muted">${fecha.toLocaleTimeString('es-CO')}</small>
                </td>
                <td><strong>${mov.nombreProducto}</strong></td>
                <td>
                    <span class="badge ${tipoBadge}">
                        <i class="fas ${tipoIcon}"></i> ${mov.tipo}
                    </span>
                </td>
                <td><strong>${mov.cantidad}</strong></td>
                <td>${mov.stockAnterior || 'N/A'}</td>
                <td><strong>${mov.stockNuevo || 'N/A'}</strong></td>
                <td>${mov.motivo || '-'}</td>
                <td>${mov.usuario || 'Sistema'}</td>
                <td>
                    <button class="btn btn-sm btn-danger" onclick="eliminarMovimiento(${mov.movimientoId})" title="Eliminar">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
        `;
    });
    
    html += `</tbody></table></div>`;
    document.getElementById('movimientosContainer').innerHTML = html;
}

function calcularEstadisticas(movimientos) {
    const entradas = movimientos.filter(m => m.tipo === 'Entrada');
    const salidas = movimientos.filter(m => m.tipo === 'Salida');
    
    const totalEntradas = entradas.reduce((sum, m) => sum + m.cantidad, 0);
    const totalSalidas = salidas.reduce((sum, m) => sum + m.cantidad, 0);
    const balance = totalEntradas - totalSalidas;
    
    document.getElementById('totalEntradas').textContent = totalEntradas;
    document.getElementById('totalSalidas').textContent = totalSalidas;
    document.getElementById('totalMovimientos').textContent = movimientos.length;
    document.getElementById('balanceMovimientos').textContent = balance;
}

function limpiarFiltrosMovimientos() {
    document.getElementById('filtroTipo').value = '';
    document.getElementById('filtroProducto').value = '';
    document.getElementById('filtroDesde').value = '';
    document.getElementById('filtroHasta').value = '';
    aplicarFiltrosMovimientos();
}

function eliminarMovimiento(id) {
    if (!confirm('¿Estás seguro de eliminar este movimiento? Esta acción no se puede deshacer.')) {
        return;
    }
    
    todosLosMovimientos = todosLosMovimientos.filter(m => m.movimientoId !== id);
    localStorage.setItem('movimientosInventario', JSON.stringify(todosLosMovimientos));
    
    cargarMovimientos();
}
</script>

