@{
    ViewData["Title"] = "Detalles del Proveedor";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-body">
                    <h2 class="mb-4"><i class="fas fa-truck"></i> Detalles del Proveedor</h2>
                    
                    <div id="proveedorDetails">
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-4">
                        <a href="/Proveedor/Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Volver a la lista
                        </a>
                        <a href="#" id="btnEdit" class="btn btn-warning">
                            <i class="fas fa-edit"></i> Editar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
const urlParams = new URLSearchParams(window.location.search);
const proveedorId = parseInt(urlParams.get('id'));

document.addEventListener('DOMContentLoaded', function() {
    const proveedores = JSON.parse(localStorage.getItem('proveedores') || '[]');
    const proveedor = proveedores.find(p => p.proveedorId === proveedorId);
    
    if (!proveedor) {
        document.getElementById('proveedorDetails').innerHTML = `
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle"></i> Proveedor no encontrado
            </div>
        `;
        return;
    }
    
    document.getElementById('btnEdit').href = `/Proveedor/Edit?id=${proveedorId}`;
    
    document.getElementById('proveedorDetails').innerHTML = `
        <dl class="row">
            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">${proveedor.nombre}</dd>
            
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">${proveedor.email}</dd>
            
            <dt class="col-sm-3">Teléfono</dt>
            <dd class="col-sm-9">${proveedor.telefono}</dd>
            
            <dt class="col-sm-3">Dirección</dt>
            <dd class="col-sm-9">${proveedor.direccion}</dd>
            
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                <span class="badge ${proveedor.activo ? 'bg-success' : 'bg-secondary'}">
                    ${proveedor.activo ? 'Activo' : 'Inactivo'}
                </span>
            </dd>
        </dl>
    `;
});
</script>

