@model IEnumerable<LOGIN.USUARIO.SEGURIDAD.Models.Usuario>
@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="fas fa-users-cog"></i> Gestión de Usuarios del Sistema</h2>
        </div>
        <div class="col text-end">
            <a href="/Admin/Dashboard" class="btn btn-secondary me-2">
                <i class="fas fa-arrow-left"></i> Volver al Panel
            </a>
            <a href="/Admin/Create" class="btn btn-primary">
                <i class="fas fa-user-plus"></i> Nuevo Usuario
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div id="usuariosContainer">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th><i class="fas fa-hashtag"></i> ID</th>
                                    <th><i class="fas fa-user"></i> Nombre Completo</th>
                                    <th><i class="fas fa-envelope"></i> Email</th>
                                    <th><i class="fas fa-id-badge"></i> Usuario</th>
                                    <th><i class="fas fa-shield-alt"></i> Rol</th>
                                    <th><i class="fas fa-toggle-on"></i> Estado</th>
                                    <th><i class="fas fa-calendar"></i> Fecha Creación</th>
                                    <th width="150"><i class="fas fa-cog"></i> Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var usuario in Model)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">#@usuario.UsuarioId</span></td>
                                        <td>@usuario.NombreCompleto</td>
                                        <td>@usuario.Email</td>
                                        <td><strong>@usuario.NombreUsuario</strong></td>
                                        <td>
                                            @if (usuario.RolId == 1)
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="fas fa-crown"></i> Administrador
                                                </span>
                                            }
                                            else if (usuario.RolId == 2)
                                            {
                                                <span class="badge bg-primary">
                                                    <i class="fas fa-user"></i> Usuario
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Rol @usuario.RolId</span>
                                            }
                                        </td>
                                        <td>
                                            @if (usuario.Estado == "Activo")
                                            {
                                                <span class="badge bg-success">
                                                    <i class="fas fa-check-circle"></i> Activo
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="fas fa-times-circle"></i> Inactivo
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (usuario.FechaCreacion != default(DateTime))
                                            {
                                                <small class="text-muted">
                                                    @usuario.FechaCreacion.ToString("dd/MM/yyyy")
                                                </small>
                                            }
                                            else
                                            {
                                                <small class="text-muted">-</small>
                                            }
                                        </td>
                                        <td>
                                            <a href="/Admin/Edit/@usuario.UsuarioId" class="btn btn-sm btn-warning" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="/Admin/Delete/@usuario.UsuarioId" class="btn btn-sm btn-danger" title="Eliminar" onclick="return confirm('¿Estás seguro de eliminar este usuario?')">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="mt-3">
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> 
                            <strong>Total:</strong> @Model.Count() usuario(s) registrado(s) en el sistema
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning text-center" role="alert">
                        <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                        <h4>No hay usuarios registrados en la base de datos</h4>
                        <p class="mb-3">Los usuarios se están gestionando desde localStorage. Haz clic abajo para ver los usuarios locales.</p>
                        <button onclick="cargarUsuariosLocales()" class="btn btn-primary">
                            <i class="fas fa-sync"></i> Cargar Usuarios de localStorage
                        </button>
                    </div>
                    <div id="usuariosLocales" style="display: none;"></div>
                }
            </div>
        </div>
    </div>
</div>

<script>
function cargarUsuariosLocales() {
    const usuarios = JSON.parse(localStorage.getItem('usuariosRegistrados') || '[]');
    const container = document.getElementById('usuariosLocales');
    
    if (usuarios.length === 0) {
        container.innerHTML = `
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle"></i> No hay usuarios en localStorage tampoco.
            </div>
        `;
        container.style.display = 'block';
        return;
    }
    
    let html = `
        <h4 class="mt-4 mb-3"><i class="fas fa-database"></i> Usuarios en localStorage</h4>
        <div class="table-responsive">
            <table class="table table-hover table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Usuario</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th>Fecha Registro</th>
                    </tr>
                </thead>
                <tbody>`;
    
    usuarios.forEach((user, index) => {
        const fecha = user.fechaRegistro ? new Date(user.fechaRegistro).toLocaleDateString() : '-';
        const rolClass = user.rol === 'Admin' ? 'bg-danger' : 'bg-primary';
        const rolIcon = user.rol === 'Admin' ? 'fa-crown' : 'fa-user';
        
        html += `
            <tr>
                <td><span class="badge bg-secondary">#${user.id || index + 1}</span></td>
                <td><strong>${user.usuario}</strong></td>
                <td>${user.email}</td>
                <td><span class="badge ${rolClass}"><i class="fas ${rolIcon}"></i> ${user.rol}</span></td>
                <td><small class="text-muted">${fecha}</small></td>
            </tr>
        `;
    });
    
    html += `
                </tbody>
            </table>
        </div>
        <div class="alert alert-success mt-3">
            <i class="fas fa-check-circle"></i> <strong>Total:</strong> ${usuarios.length} usuario(s) en localStorage
        </div>
    `;
    
    container.innerHTML = html;
    container.style.display = 'block';
}

// Cargar automáticamente si no hay usuarios en BD
document.addEventListener('DOMContentLoaded', function() {
    const hasBdUsers = @(Model != null && Model.Any() ? "true" : "false");
    if (!hasBdUsers) {
        // Auto-cargar usuarios de localStorage después de 1 segundo
        setTimeout(() => {
            cargarUsuariosLocales();
        }, 500);
    }
});
</script>
